   "label": "POL Entries",
   "reqd": 1
  },
  {
   "fieldname": "sec_totals",
   "fieldtype": "Section Break",
   "label": "Fuel and Book Balance"
  },
  {
   "fieldname": "total_fuel_supplied",
   "fieldtype": "Float",
   "label": "Total Fuel Supplied (Ltr)",
   "read_only": 1,
   "precision": "3",
   "description": "SUM of the POL entry litres. Never entered by hand."
  },
  {
   "fieldname": "total_amount_bod",
   "fieldtype": "Currency",
   "label": "Amount (BOD)",
   "read_only": 1,
   "hidden": 1,
   "description": "SUM of the BOD lines. Hidden at GDL's request - the split now follows each line's supplier, so it is derived, not read. The BOD book balance and the claim raised on that provider are both worked out from it."
  },
  {
   "fieldname": "total_amount_stcbl",
   "fieldtype": "Currency",
   "label": "Amount (STCBL)",
   "read_only": 1,
   "hidden": 1,
   "description": "SUM of the STCBL lines. Hidden at GDL's request - the split now follows each line's supplier, so it is derived, not read. The STCBL book balance and the claim raised on that provider are both worked out from it."
  },
  {
   "fieldname": "col_tot_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "opening_book_balance_bod",
   "fieldtype": "Currency",
   "label": "Opening Book Balance (BOD)",
