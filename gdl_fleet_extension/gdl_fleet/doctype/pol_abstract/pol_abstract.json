  },
  {
   "fieldname": "col_head_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "period_from",
   "fieldtype": "Date",
   "label": "Period From",
   "reqd": 1,
   "in_standard_filter": 1,
   "description": "The POL reporting period is explicit. It is not a calendar month - the customer's own abstracts span month boundaries."
  },
  {
   "fieldname": "period_to",
   "fieldtype": "Date",
   "label": "Period To",
   "reqd": 1,
   "in_standard_filter": 1
  },
