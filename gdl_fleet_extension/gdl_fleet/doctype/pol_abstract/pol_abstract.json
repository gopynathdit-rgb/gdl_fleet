  },
  {
   "fieldname": "opening_book_balance_stcbl",
   "fieldtype": "Currency",
   "label": "Opening Book Balance (STCBL)",
   "read_only": 1,
   "description": "Unspent STCBL coupon carried in from this vehicle's previous abstract."
  },
  {
   "fieldname": "recoupment_bod",
   "fieldtype": "Currency",
   "label": "Total Fuel Recoupment (BOD)",
   "description": "The standing recoupment for this provider. This is the figure the fuel book balance is worked out from."
  },
  {
   "fieldname": "recoupment_stcbl",
   "fieldtype": "Currency",
   "label": "Total Fuel Recoupment (STCBL)",
   "description": "The standing recoupment for this provider. This is the figure the fuel book balance is worked out from."
  },
  {
   "fieldname": "fuel_book_balance_bod",
   "fieldtype": "Currency",
   "label": "Closing Book Balance (BOD)",
   "read_only": 1,
   "description": "Opening + Recouped - Spent. Carries into the next abstract."
  },
  {
   "fieldname": "fuel_book_balance_stcbl",
   "fieldtype": "Currency",
   "label": "Closing Book Balance (STCBL)",
   "read_only": 1,
   "description": "Opening + Recouped - Spent. Carries into the next abstract."
  },
  {
