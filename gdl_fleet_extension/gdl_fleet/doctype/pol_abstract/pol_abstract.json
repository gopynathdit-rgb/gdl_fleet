   "fieldtype": "Select",
   "options": "KM\nHours",
   "default": "KM",
   "label": "Distance Basis",
   "reqd": 1,
   "description": "KM for odometer-metered vehicles, Hours for hour-metered plant. Performance is reported per litre either way."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "Draft\nSubmitted\nApproved\nRejected\nCancelled",
   "default": "Draft",
   "label": "Status",
   "read_only": 1,
   "in_standard_filter": 1,
   "in_list_view": 1,
   "no_copy": 1
  },
