<style>
@page { size: A4; margin: 20mm 16mm 18mm 16mm;
  @bottom-center { content: counter(page); font-family: Calibri, sans-serif;
                    font-size: 8pt; color: #7C8C8A; } }
body { font-family: Calibri, "Segoe UI", sans-serif; font-size: 10.5pt; color: #131F1E;
        line-height: 1.45; }
h1 { font-size: 18pt; color: #0F5257; margin: 0 0 10pt; page-break-before: always; }
h1.first { page-break-before: avoid; }
h3 { font-size: 11pt; color: #556666; margin: 14pt 0 5pt; }
p { margin: 0 0 7pt; }
ul, ol { margin: 0 0 8pt 16pt; padding: 0; }
li { margin-bottom: 3pt; }
table { border-collapse: collapse; width: 100%; margin: 0 0 10pt; font-size: 9pt; }
th { background: #0F5257; color: #fff; text-align: left; padding: 5pt 6pt;
      border: 0.5pt solid #0F5257; }
td { padding: 4pt 6pt; border: 0.5pt solid #CBD8D6; vertical-align: top; }
tr:nth-child(even) td { background: #F2F6F5; }
.note { border-left: 2pt solid #0F5257; background: #E4EFEF; padding: 6pt 9pt;
         margin: 0 0 10pt; font-size: 9.5pt; font-style: italic; }
.note b { font-style: normal; color: #0F5257; }
.title-page { text-align: center; page-break-after: always; padding-top: 55mm; }
.title-page .t { font-size: 34pt; font-weight: bold; color: #0F5257; }
.title-page .s { font-size: 18pt; color: #556666; margin-top: 6pt; }
.title-page .m { font-size: 11pt; margin-top: 26pt; }
.title-page .e { font-size: 9.5pt; color: #7C8C8A; margin-top: 60mm; }
